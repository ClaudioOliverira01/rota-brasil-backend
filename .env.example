# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o Git.

# Porta da API local
PORT=3333

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://SEUPROJETO.supabase.co

# Recomendado: chave SECRETA (service_role / "secret key"). Fica só no backend.
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# Compatibilidade: se preferir manter a chave pública (anon / "publishable"),
# deixe SUPABASE_SERVICE_ROLE_KEY vazia e preencha esta. A migration 001 cria
# as políticas de RLS necessárias para ela.
SUPABASE_ANON_KEY=

# --- CORS ---
# URL(s) do frontend permitidas, separadas por vírgula.
# Local: http://localhost:5173 (localhost em qualquer porta já é liberado)
# Produção: a URL que a Vercel gerar para o frontend.
FRONTEND_URL=https://SEU-FRONTEND.vercel.app

# true = também aceita previews da Vercel (https://*.vercel.app)
ALLOW_VERCEL_PREVIEWS=false

# Sem Supabase configurado, a API usa a memória (dados somem ao reiniciar).
# Por padrão isso só é permitido fora de produção. true/false força a escolha.
# ALLOW_MEMORY_STORAGE=true
